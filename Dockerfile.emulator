FROM python:3.13-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc tzdata && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir numpy scipy pandas paho-mqtt pyyaml

WORKDIR /app

COPY emulator/ /app/emulator/
COPY entrypoint-emulator.sh /app/entrypoint-emulator.sh
RUN chmod +x /app/entrypoint-emulator.sh

RUN mkdir -p /app/state /app/model

ENV STATE_DIR=/app/state
ENV MODEL_DIR=/app/model
ENV CONFIG_PATH=/app/model/EMULATOR_config.json
ENV DB_EMULATOR_PATH=/app/model/db_emulator.json
ENV MQTT_BROKER=mosquitto
ENV MQTT_PORT=1883
ENV DATA_DIR=/app/state
ENV PIO_DB_PATH=/home/pioreactor/.pioreactor/storage/pioreactor.sqlite

ENTRYPOINT ["python", "-m", "emulator.cli"]
CMD ["start"]
