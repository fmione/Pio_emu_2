# === Leader (ephemeral, NOT config.ini) ===
.pioreactor/storage/
.pioreactor/hardware/
.pioreactor/ui/
.pioreactor/exportable_datasets/
.pioreactor/plugins/
.pioreactor/experiment_profiles/*

# === Worker (everything is regenerated by entrypoint, except config.ini) ===
.pioreactor-worker/*
!.pioreactor-worker/config.ini

# === Extra workers generated by compose.sh ===
.pioreactor-worker-*/

# === Compose override generated by compose.sh ===
.compose-workers.yml

# === Root ===
pioreactor.log
__pycache__/
*.pyc

# === Environment file ===
.env