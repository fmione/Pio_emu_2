# === Leader (ephemeral, NOT config.ini) ===
.pioreactor/storage/
.pioreactor/hardware/
.pioreactor/ui/
.pioreactor/exportable_datasets/
.pioreactor/plugins/
.pioreactor/experiment_profiles/*
!.pioreactor/experiment_profiles/profile_updated.yaml

# === Worker (todo es regenerado por entrypoint, excepto config.ini) ===
.pioreactor-worker/*
!.pioreactor-worker/config.ini

# === Emulator state (ephemeral, regenerated each run) ===
emulator/state/

# === Emulator model runtime output (generated by model/, NOT the sources) ===
emulator/model/EMULATOR_state.json
emulator/model/EMULATOR_design.json
emulator/model/db_emulator.json
emulator/model/measurements_atline.csv

# === Root ===
pioreactor.log
__pycache__/
*.pyc

# === Environment file ===
.env